{
  "name": "agxp-a2a-recruiting-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AGXP A2A recruiting — job-seeker frontend (React + TypeScript, Capacitor-ready)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:data-source": "playwright test --config=playwright.数据源模式.config.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "node 脚本/发布到Pages.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
